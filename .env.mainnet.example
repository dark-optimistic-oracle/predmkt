PRIVATE_KEY=replace_with_a_funded_mainnet_private_key
PROTOCOL_ADMIN=replace_with_the_matching_secure_address
CONFIRM_MAINNET_DEPLOYMENT=I_UNDERSTAND_THIS_BROADCASTS_TO_MAINNET
