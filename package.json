{
  "name": "dark-optimistic-oracle-prediction-market",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm lint && pnpm test && pnpm security:static && pnpm build",
    "lint": "eslint .",
    "preview": "vite preview",
    "security:audit": "pnpm audit --prod",
    "security:static": "./scripts/security_check.sh",
    "test": "vitest --run",
    "test:contracts": "./contracts/test_all.sh",
    "test:integration:local": "./scripts/test_local_integration.sh",
    "deploy:check": "./deploy_local_devnet.sh --dry-run && ./deploy_testnet.sh --dry-run && ./deploy_mainnet.sh --dry-run"
  },
  "dependencies": {
    "@provablehq/aleo-types": "1.0.1",
    "@provablehq/aleo-wallet-adaptor-core": "1.0.1",
    "@provablehq/aleo-wallet-adaptor-react": "1.0.1",
    "@provablehq/aleo-wallet-adaptor-react-ui": "1.0.1",
    "@provablehq/aleo-wallet-adaptor-shield": "1.0.1",
    "lucide-react": "0.300.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "brace-expansion": "5.0.9"
    }
  }
}
